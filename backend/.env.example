PORT=5000
NODE_ENV=development

APP_URL=http://localhost:5173

# PostgreSQL (Supabase or local)
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_crm

# Supabase (optional, for Supabase-hosted DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Algolia Search
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_SEARCH_KEY=your-algolia-search-api-key
ALGOLIA_WRITE_KEY=your-algolia-write-api-key
ALGOLIA_ADMIN_KEY=your-algolia-admin-api-key

# CORS
CORS_ORIGIN=*

# Account Security
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=15
RESET_TOKEN_EXPIRY_MINUTES=30
