# -------------------------------------------------------------------
# API Configuration
# -------------------------------------------------------------------
# In development, Vite proxies /api -> Mockoon (http://localhost:3001)
# so requests are same-origin and CORS is not an issue.
#
# To switch backends, change VITE_API_BASE_URL:
#   /api                          Vite proxy -> Mockoon (default, no CORS)
#   http://localhost:3001         Direct to Mockoon (needs CORS headers)
#   https://54c19606-...mock.pstmn.io    Postman Mock Server
#   https://api.example.com       Production backend
# -------------------------------------------------------------------
VITE_API_BASE_URL=/api

# Alternative backends (uncomment one to use):
#VITE_API_BASE_URL=http://localhost:3001
#VITE_API_BASE_URL=https://6c43a4d2-cc72-414f-b601-b2ff6891a15b.mock.pstmn.io
#VITE_API_BASE_URL=https://api.example.com
