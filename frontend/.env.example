# -------------------------------------------------------------------
# API Configuration (Example Placeholders)
# -------------------------------------------------------------------
# In development, Vite proxies /api -> Mockoon (http://localhost:3001)
# so requests are same-origin and CORS is not an issue.
# -------------------------------------------------------------------
VITE_API_BASE_URL=/api

